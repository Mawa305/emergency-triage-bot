    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst name = (body.name || '').toString().trim();\nconst phone = (body.phone || '').toString().replace(/[^\\d+]/g, '');\nconst message = (body.message || '').toString().trim();\n\nconst errors = [];\nif (!name) errors.push('missing_name');\nif (phone.length < 10) errors.push('invalid_phone');\nif (message.length < 5) errors.push('message_too_short');\n\nreturn [{\n  json: {\n    name,\n    phone,\n    message,\n    is_valid: errors.length === 0,\n    errors: errors.join(',')\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
