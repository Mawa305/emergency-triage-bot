    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst text = raw.message?.content || raw.output?.[0]?.content?.[0]?.text || raw.text || '';\nconst base = $('Validate Input').first().json;\n\nlet category = 'urgent';\nlet reason = 'AI output invalid, defaulted to urgent';\n\ntry {\n  const parsed = JSON.parse(text.replace(/```json|```/g, '').trim());\n  if (['emergency', 'urgent', 'routine'].includes(parsed.category)) {\n    category = parsed.category;\n    reason = parsed.reason || '';\n  }\n} catch (e) {}\n\n// Safety net: safety keywords always mean emergency\nconst safetyWords = ['gas', 'carbon monoxide', 'smoke', 'fire', 'burning', 'sparks', 'flood'];\nif (safetyWords.some(w => base.message.toLowerCase().includes(w))) {\n  category = 'emergency';\n  reason = 'Safety keyword detected: ' + reason;\n}\n\nreturn [{ json: { ...base, category, reason } }];"
      },
